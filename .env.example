# Copy to .env for local development. Never commit real values.
TRIAGE_ENV=local
TRIAGE_LOG_LEVEL=INFO
TRIAGE_LOG_JSON=false

TRIAGE_DATABASE_URL=postgresql+asyncpg://triage:triage@localhost:5432/triage
TRIAGE_REDIS_URL=redis://localhost:6379/0

# Per-client HMAC secrets as JSON: {"client-name": "<secret>"}. Client names must match an API client.
TRIAGE_WEBHOOK_HMAC_SECRETS={}

# disabled | dry_run | enabled (enabled requires a real executor; phase 3)
TRIAGE_REMEDIATION_MODE=dry_run
TRIAGE_APPROVAL_TTL_SECONDS=3600
TRIAGE_VERIFY_DELAY_SECONDS=120
TRIAGE_MUTE_WINDOW_SECONDS=3600
TRIAGE_RATE_LIMIT_PER_MINUTE=600

# mock | gemini. For Gemini, set both variables in the worker environment.
TRIAGE_TRIAGE_AGENT=mock
# TRIAGE_GEMINI_MODEL=
# TRIAGE_GEMINI_API_KEY=
